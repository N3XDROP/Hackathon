# Tipo de base de datos
DB_TYPE=mysql

# Configuración de conexión local (XAMPP)
HOST_DATA_BASE=127.0.0.1
PORT_DATA_BASE=3306
USER_DATA_BASE=root
PASSWORD_DATA_BASE=
NAME_DATA_BASE=hackathon_db

# TLS no aplica para MySQL local
# DB_TLS=

# Variables generales del proyecto
PORTAPP=4000
NODE_ENV=development

# Secretos y autenticación
SSO_JWT_SECRET=una_super_secreta_larga
SESSION_SECRET=your-session-secret-key-here
JWT_SECRET=hackathon_secret_key

# URL del frontend local
FRONTEND_URL=http://localhost:5173